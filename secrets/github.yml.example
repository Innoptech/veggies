---
# Structure of secrets/github.yml - copy, fill, encrypt: mask vault-edit secrets/github.yml
# Consumed by: terraform github module (env export at plan/apply) and
# the github_runner role (registration-token flow).

# Bot identity for agent commits. TODO(you): choose GitHub App (recommended) or
# a bot-account PAT - fill only the matching block.
github_app_id: "" # TODO(you)
github_app_installation_id: "" # TODO(you)
github_app_private_key: "" # TODO(you): PEM, multiline - use a | block scalar

github_token: "" # bot-account PAT; leave empty when using the App above

# ADR 0033: serve password for github-enabled veggies stacks (read by the
# veggies CLI); the same value goes to the repo's VEGGIES_STACK_PASSWORD
# Actions secret via the actions_secrets map - keep them equal.
veggies_stack_password: "" # TODO(you): openssl rand -hex 24

# Fed to TF_VAR_actions_secrets / TF_VAR_actions_variables by
# scripts/tfvars_from_vault.py; consumed by terraform/github/secrets.tf.
actions_secrets:
  veggies:
    VEGGIES_STACK_PASSWORD: "" # same value as veggies_stack_password
actions_variables:
  veggies:
    VEGGIES_STACK_HOST: "host.containers.internal"
    VEGGIES_STACK_PORT: "" # TODO(you): the stack's published port (veggies ls)
