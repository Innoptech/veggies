---
# Structure of secrets/github.yml - copy, fill, encrypt: mask vault-edit secrets/github.yml
# Consumed by: the terraform github module (app_auth via TF_VAR_github_app_*
# at plan/apply), the github_runner role (app.pem + api.env), the github-auth
# sidecar of github-enabled stacks, and the CLI's private clone/pull (ADR 0063).

# The one GitHub identity: the org-owned veggies-harness GitHub App. App ID
# and Installation ID are on the App's settings page / the installation URL
# (.../settings/installations/<ID>); the private key is generated there too.
github_app_id: "" # TODO(you)
github_app_installation_id: "" # TODO(you)
github_app_private_key: | # TODO(you): the PEM, as a `|` block scalar (never `>` - folding destroys it)
  -----BEGIN RSA PRIVATE KEY-----
  ...
  -----END RSA PRIVATE KEY-----

# ADR 0033: serve password for github-enabled veggies stacks (read by the
# veggies CLI). ADR 0048: the same key ALSO feeds each agent-kick module
# block's VEGGIES_STACK_PASSWORD Actions secret via
# TF_VAR_veggies_stack_password (scripts/tfvars_from_vault.py).
veggies_stack_password: "" # TODO(you): openssl rand -hex 24

# Fed to TF_VAR_actions_secrets / TF_VAR_actions_variables by
# scripts/tfvars_from_vault.py; consumed by terraform/github/secrets.tf.
# NOT the VEGGIES_* trio: the VEGGIES_STACK_* secret/variables come from the
# repo's agent-kick block in terraform/github/agent_kicks.tf (ADR 0048).
# These maps remain for arbitrary per-repo secrets/variables, e.g.:
# actions_secrets:
#   some-repo:
#     SOME_TOKEN: "..."
actions_secrets: {}
actions_variables: {}
