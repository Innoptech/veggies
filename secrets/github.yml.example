---
# Structure of secrets/github.yml - copy, fill, encrypt: mask vault-edit secrets/github.yml
# Consumed by: terraform github module (env export at plan/apply, phase 2) and
# the github_runner role (registration-token flow, phase 5).

# Bot identity for agent commits. TODO(you): choose GitHub App (recommended) or
# a bot-account PAT in phase 2 - fill only the matching block.
github_app_id: "" # TODO(you)
github_app_installation_id: "" # TODO(you)
github_app_private_key: "" # TODO(you): PEM, multiline - use a | block scalar

github_token: "" # bot-account PAT; leave empty when using the App above
