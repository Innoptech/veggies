---
# Structure of secrets/infra.yml - copy, fill, encrypt: mask vault-edit secrets/infra.yml
# Consumed by: tailscale role (phase 4), backup role (phase 8).

# Reusable, pre-authorized for tailscale_tag, ephemeral=false.
# TODO(you): generate in the tailnet admin console (phase 4)
tailscale_auth_key: "tskey-auth-REPLACE_ME"

# infra-apply.yml converge job: Tailscale OAuth client (tag:ci) and the
# dedicated ssh keypair authorized for fedora on garden (pubkey goes in
# admin_ssh_public_keys in group_vars).
# TODO(you): both only needed once infra-apply is enabled (phase 9)
tailscale_oauth_client_id: "REPLACE_ME"
tailscale_oauth_secret: "tskey-client-REPLACE_ME"
converge_ssh_private_key: "" # TODO(you): PEM/OpenSSH private key, multiline |

# restic (phase 8)
restic_password: "REPLACE_ME" # TODO(you): openssl rand -base64 32
restic_s3_access_key: "REPLACE_ME" # TODO(you): OVH object storage credentials
restic_s3_secret_key: "REPLACE_ME"

# Optional: gets a log line + HTTP POST when disk exceeds backup_cleanup_disk_alert_percent
backup_cleanup_webhook_url: ""
