---
# Structure of secrets/model.yml - copy, fill, encrypt: mask vault-edit secrets/model.yml
# Consumed by: the litellm quadlet (phase 6) and nothing else. The Fireworks key
# must NEVER land in opencode's env or in runner containers (ADR 0011).

# Fireworks AI - serves kimi/deepseek/glm through one key.
fireworks_api_key: "fw-REPLACE_ME" # TODO(you)

# LiteLLM proxy auth. You generate these; scoped per consumer so a leak is
# revocable and budget-cappable (ADR 0011).
litellm_master_key: "sk-REPLACE_ME" # TODO(you): openssl rand -hex 32
litellm_runner_virtual_key: "sk-REPLACE_ME" # TODO(you): openssl rand -hex 32
litellm_opencode_virtual_key: "sk-REPLACE_ME" # TODO(you): openssl rand -hex 32
