---
profile: production
exclude_paths:
  - .venv/
  - .cache/
  - .pytest_cache/
  - secrets/ # vault-encrypted files are not parseable YAML by design
  - ansible/collections/ # galaxy install target - vendored collections, not ours
  - agent-config/ # opencode/litellm config, not ansible content
  - tests/golden/ # machine-generated kube YAML snapshots (ADR 0013)
  - "**/molecule/**/.molecule/"
