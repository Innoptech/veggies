#!/usr/sbin/nft -f
# Managed by Ansible (infra repo, egress role).
# A dedicated table - firewalld owns its own tables and never touches this one.
table inet infra-egress
flush table inet infra-egress

table inet infra-egress {
  chain output {
    type filter hook output priority 0; policy accept;

    # Return traffic for allowed connections (all users).
    ct state { established, related } accept

{% for uid in egress_denied_uids %}
{% set uname = egress_denied_users[loop.index0] %}
    # {{ uname }} may reach exactly two local
    # services: the filtering proxy and the model gateway. The host's own
    # public IP is required too: pasta forwards container->host proxy
    # connections to it (verified 2026-09-08 - else in-pod proxy use drops).
    meta skuid {{ uid }} ip daddr { 127.0.0.1, {{ egress_host_gateway }}, {{ ansible_facts.default_ipv4.address }} } tcp dport {{ egress_squid_port }} counter accept
{% if egress_extra_local_dports.get(uname) %}

    # {{ uname }} only: extra host-local dports per egress_extra_local_dports
    # (for gh-runner: the stack API range, agent-trigger kicks - ADR 0033).
    meta skuid {{ uid }} ip daddr { 127.0.0.1, {{ egress_host_gateway }}, {{ ansible_facts.default_ipv4.address }} } tcp dport {{ egress_extra_local_dports[uname] }} counter accept
{% endif %}

    # Everything else from {{ uname }}: logged and dropped.
    meta skuid {{ uid }} log prefix "infra-egress-deny: " counter drop
{% endfor %}
  }
}
