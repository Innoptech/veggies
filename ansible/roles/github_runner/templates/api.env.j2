# Managed by Ansible (infra repo, github_runner role). From secrets/github.yml.
# ADR 0063: the fetcher mints a GitHub App installation token narrowed to
# runner administration, then asks for the registration token. The private
# key lives in app.pem (0600) - KEY=value files cannot hold a PEM.
GITHUB_APP_ID={{ github_app_id }}
GITHUB_APP_INSTALLATION_ID={{ github_app_installation_id }}
GITHUB_APP_PEM_PATH=/home/{{ github_runner_user }}/.config/gh-runner/app.pem
GITHUB_OWNER={{ github_owner }}
GITHUB_RUNNER_SCOPE={{ github_runner_scope }}
GITHUB_RUNNER_LABELS={{ github_runner_labels | join(',') }}
# The token fetcher runs on the host as gh-runner; its API calls also go
# through the proxy (urllib honors these env vars).
HTTPS_PROXY=http://127.0.0.1:3128
HTTP_PROXY=http://127.0.0.1:3128
NO_PROXY=127.0.0.1,localhost
