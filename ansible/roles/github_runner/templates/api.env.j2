# Managed by Ansible (infra repo, github_runner role). From secrets/github.yml.
GH_RUNNER_ADMIN_TOKEN={{ github_token }}
GITHUB_OWNER={{ github_owner }}
GITHUB_RUNNER_SCOPE={{ github_runner_scope }}
GITHUB_RUNNER_LABELS={{ github_runner_labels | join(',') }}
# The token fetcher runs on the host as gh-runner; its API call also goes
# through the proxy (urllib honors these env vars).
HTTPS_PROXY=http://127.0.0.1:3128
HTTP_PROXY=http://127.0.0.1:3128
NO_PROXY=127.0.0.1,localhost
