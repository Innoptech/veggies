{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/kimi-k3",
  "small_model": "litellm/glm-5",
  "share": "disabled",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "veggies-litellm",
      "options": {
        "baseURL": "http://host.containers.internal:4000/v1"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3 (via Fireworks)"
        },
        "deepseek-v4": {
          "name": "DeepSeek V4 (via Fireworks)"
        },
        "glm-5": {
          "name": "GLM 5 (via Fireworks)"
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "secrets/*.yml": "deny",
      "secrets/*.yaml": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow"
    },
    "doom_loop": "deny",
    "question": "deny",
    "skill": {
      "*": "allow"
    }
  }
}
