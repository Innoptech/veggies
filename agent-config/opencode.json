{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/kimi-k3",
  "small_model": "litellm/glm-5",
  "share": "disabled",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#b36e0829c6d0140e93cfef2ca599b1b07d4a7797"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "veggies-litellm",
      "options": {
        "baseURL": "http://host.containers.internal:4000/v1"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3 (via Fireworks)"
        },
        "deepseek-v4": {
          "name": "DeepSeek V4 (via Fireworks)"
        },
        "glm-5": {
          "name": "GLM 5 (via Fireworks)"
        }
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
